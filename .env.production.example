# ── Template production — copy ke .env.production DI SERVER, isi nilai nyata ──
#   cp .env.production.example .env.production && chmod 600 .env.production
# File ini di-commit TANPA nilai rahasia. .env.production sudah di-gitignore.
# Nilai $(...) TIDAK diekspansi oleh compose/dotenv — generate dulu, tempel hasil literal.

# ── Database (dibaca aplikasi) ─ nilai HARUS sama dengan MYSQL_* di bawah ──
DB_NAME=dashboardku_prod
DB_USER=dashboardku_user
DB_PASS=<password-kuat-random>
# DB_HOST/DB_PORT tidak perlu — di-override compose ke 'mysql'

# ── Database (init container MySQL) ──
MYSQL_ROOT_PASSWORD=<root-password-kuat-random>
MYSQL_DATABASE=dashboardku_prod
MYSQL_USER=dashboardku_user
MYSQL_PASSWORD=<password-kuat-random>   # WAJIB samakan dengan DB_PASS di atas

# ── Flask ──
# Generate: openssl rand -hex 32
SECRET_KEY=<hasil-openssl-rand-hex-32>
DEBUG=false

# ── Auth seed (docker compose exec app flask create-user) ──
# Generate: python3 -c "import bcrypt; print(bcrypt.hashpw(b'password_anda', bcrypt.gensalt()).decode())"
#
# PENTING: '$' di env_file DI-INTERPOLASI docker compose — setiap '$' di hash
# bcrypt WAJIB ditulis '$$'. Contoh: hash asli $2b$12$abc... → $$2b$$12$$abc...
# Tanpa escaping hash terpotong diam-diam → login selalu gagal.
#
# Alternatif tanpa env (lebih aman): kosongkan APP_PASSWORD_HASH, jalankan interaktif:
#   docker compose -f docker-compose.prod.yml exec -it app flask create-user -p "password-anda"
APP_USERNAME=admin
APP_PASSWORD_HASH=<bcrypt-hash-literal-dengan-$-ditulis-$$>

# ── Hardening session (HTTPS pasti di kedua jalur akses) ──
SESSION_COOKIE_SECURE=true
