# ── Database ───────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=dashboardku
DB_USER=dashboardku
DB_PASS=secret

# ── Auth ───────────────────────────────────────────────────
# Username & password for single-user login
APP_USERNAME=admin
APP_PASSWORD=changeme

# Session secret (change in production)
SECRET_KEY=change-this-to-a-random-string

# ── Webhook / WAHA ────────────────────────────────────────
WAHA_WEBHOOK_URL=https://your-waha-endpoint.com/webhook

# ── App ───────────────────────────────────────────────────
APP_ENV=development
DEBUG=true
